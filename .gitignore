# Python Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Node.js & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Build and Distribution Folders
dist/
build/
out/
.next/
.vite/
*.egg-info/
*.egg

# Environment Variables & Secrets (Do not commit credentials or API keys)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt

# Database and Large Datasets (Do not commit raw dumps or local databases)
*.sqlite
*.sqlite3
*.db
*.duckdb
*.parquet
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/*
!data/synthetic/.gitkeep

# MinIO Local Data
minio-data/

# Temporary and Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.tmp
*.temp
*.swp
*.swo
*~

# Logs
*.log
logs/

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
